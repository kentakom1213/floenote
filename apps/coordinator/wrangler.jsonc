{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "floe-note-coordinator",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_COORDINATOR",
        "class_name": "ProjectCoordinator"
      },
      {
        "name": "INVITATION_COORDINATOR",
        "class_name": "InvitationCoordinator"
      }
    ]
  },
  "exports": {
    "ProjectCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "InvitationCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
