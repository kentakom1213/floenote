{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "floe-note-coordinator",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "ratelimits": [
    {
      "name": "TURN_DEVICE_RATE_LIMIT",
      "namespace_id": "15501",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "TURN_INVITE_RATE_LIMIT",
      "namespace_id": "15502",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "TURN_INVITATION_CREATION_RATE_LIMIT",
      "namespace_id": "15503",
      "simple": { "limit": 2, "period": 60 }
    }
  ],
  "preview_urls": true,
  "routes": [
    {
      "pattern": "floe-coordinator.pwll.dev",
      "custom_domain": true,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE_COORDINATOR",
        "class_name": "WorkspaceCoordinator",
      },
      {
        "name": "INVITATION_COORDINATOR",
        "class_name": "InvitationCoordinator",
      },
    ],
  },
  "exports": {
    "WorkspaceCoordinator": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "ProjectCoordinator": {
      "type": "durable-object",
      "state": "deleted",
    },
    "InvitationCoordinator": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "observability": {
    "enabled": true,
  },
  "previews": {
    "vars": {
      "FLOE_VERSION": "preview",
      "FLOE_BUILD": "preview",
      "TURN_ENABLED": "false",
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "WORKSPACE_COORDINATOR",
          "class_name": "WorkspaceCoordinator",
        },
        {
          "name": "INVITATION_COORDINATOR",
          "class_name": "InvitationCoordinator",
        },
      ],
    },
  },
}
