{
  "name": "floe-note",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --filter @floe-note/web dev",
    "dev:coordinator": "pnpm --filter @floe-note/coordinator dev",
    "deploy:coordinator": "pnpm --filter @floe-note/coordinator run deploy",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "5.0.1"
  }
}
