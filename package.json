{
  "name": "floe-note",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --filter @floe-note/web dev",
    "dev:coordinator": "pnpm --filter @floe-note/coordinator dev",
    "deploy:coordinator": "pnpm --filter @floe-note/coordinator run deploy",
    "deploy:web": "pnpm --filter @floe-note/web build && pnpm --filter @floe-note/coordinator exec wrangler deploy --config ../web/wrangler.jsonc",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "version:web": "node scripts/bump-version.mjs web",
    "version:coordinator": "node scripts/bump-version.mjs coordinator",
    "dev:turn": "pnpm --filter @floe-note/turn dev",
    "deploy:turn": "pnpm --filter @floe-note/turn run deploy",
    "preview": "node scripts/deploy-preview.mjs",
    "preview:delete": "node scripts/delete-preview.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "jsdom": "30.1.2",
    "typescript": "^7.0.2",
    "vitest": "5.0.3",
    "@playwright/test": "1.64.0"
  },
  "pnpm": {
    "overrides": {
      "@lezer/common": "1.5.3"
    }
  }
}
